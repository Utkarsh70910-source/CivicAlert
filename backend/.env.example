# CivicAlert Backend Environment Configuration
# Copy this file to .env and configure as needed.

# Server Port (Render / cloud hosts provide process.env.PORT automatically)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Production Frontend URL(s) allowed by CORS
# Separate multiple origins with commas if using multiple domains
# Example: https://civicalert.onrender.com,https://civicalert.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas for cloud / local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/civicalert?retryWrites=true&w=majority
MONGODB_URI=
